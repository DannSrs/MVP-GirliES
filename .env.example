## Crie o próprio .env e siga as instruções desse .env.example

# Servidor & Ambiente
PORT=3000
NODE_ENV=development
CORS_ORIGIN=*

# Banco de Dados (Supabase / PostgreSQL)
DATABASE_URL="postgresql://postgres.[sua-ref]:[sua-senha]@aws-0-sa-east-1.pooler.supabase.com:6543/postgres"

## Utilize o Google Cloud Console para conseguir as keys de Auth (Futuro)
GOOGLE_CLIENT_ID="cola o id aqui"
GOOGLE_CLIENT_SECRET="cola a chave secreta aqui"