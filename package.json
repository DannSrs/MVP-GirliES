{
  "name": "mvp-girlies",
  "version": "1.0.0",
  "description": "Este é um projeto inicializado.",
  "main": "dist/index.js",
  "scripts": {
    "postinstall": "npm install --prefix frontend_react",
    "swagger": "tsoa spec-and-routes",
    "dev": "tsoa spec-and-routes && tsx watch src/index.ts",
    "dev:react": "npm run dev --prefix frontend_react",
    "build": "tsoa spec-and-routes && tsc",
    "start": "node dist/index.js",
    "build:css": "tailwindcss -i ./public/css/input.css -o ./public/css/style.css",
    "watch:css": "tailwindcss -i ./public/css/input.css -o ./public/css/style.css --watch",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DannSrs/MVP-GirliES.git"
  },
